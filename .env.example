# Copy this file to .env and fill in your real values.
# Never commit .env to git — it is listed in .gitignore.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these at: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Find this at: https://resend.com → API Keys
RESEND_API_KEY=re_your-resend-key-here

# Copied on every proposal link that goes out to a client, so client relations
# holds the same record of what was sent and when without being forwarded it.
# Both fall back to hardcoded lex-ops.io addresses if unset — which means a
# wrong or non-existent mailbox fails silently, so set them explicitly.
CLIENT_RELATIONS_EMAIL=client-relations@lex-ops.io
# Where "the client sent their proposal back" notifications land.
LEXOPS_NOTIFY_EMAIL=isuru@lex-ops.io

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
# Find this at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a-long-random-secret-string

# ── App URL ───────────────────────────────────────────────────────────────────
# Use http://localhost:5000 for local dev
SITE_URL=http://localhost:5000
