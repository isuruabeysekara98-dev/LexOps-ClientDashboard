{
  "$meta": {
    "name": "LexOps Design Tokens",
    "description": "Framework-agnostic design tokens for the LexOps brand. Mirrors css/tokens.css and the @theme block in css/globals.css.",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "dark-gray":   { "value": "#232A34", "usage": "Primary text, dark backgrounds, primary-button hover" },
      "slate-blue":  { "value": "#375971", "usage": "Primary buttons, links, accents, active states" },
      "light-slate": { "value": "#9DB5C9", "usage": "Captions, eyebrow dots, secondary icons" },
      "light-blue":  { "value": "#E4F1F8", "usage": "Hover tints, light icon-box fills, button-on-dark hover" }
    },
    "neutral": {
      "off-black":  { "value": "#0D0F13", "usage": "Deepest backgrounds / contrast" },
      "mid-gray":   { "value": "#616568", "usage": "Body copy, labels, nav links" },
      "light-gray": { "value": "#8D8D99", "usage": "Tertiary text, dividers, placeholders" },
      "white":      { "value": "#FFFFFF", "usage": "Card surfaces, text on dark" }
    },
    "surface": {
      "page-bg":    { "value": "#FAFBFC", "usage": "App body background" },
      "section-bg": { "value": "#F4F8FB", "usage": "Alternating section background, icon-box fills" },
      "hairline":   { "value": "#E8E8E8", "usage": "Footer / accordion dividers" }
    },
    "status": {
      "success":    { "value": "#3C7A52", "usage": "Status pill text + dot" },
      "success-bg": { "value": "#E7F3EC", "usage": "Status pill background" },
      "alert":      { "value": "#C9542E", "usage": "Break / alert accent" }
    }
  },
  "typography": {
    "fontFamily": "\"Satoshi\", sans-serif",
    "fontWeight": { "regular": 400, "medium": 500, "bold": 700 },
    "scale": {
      "h1":      { "size": "56px", "lineHeight": "60px", "weight": 500 },
      "h2":      { "size": "44px", "lineHeight": "52px", "weight": 400 },
      "h3m":     { "size": "34px", "lineHeight": "39px", "weight": 500 },
      "h3":      { "size": "26px", "lineHeight": "31px", "weight": 500 },
      "h4":      { "size": "20px", "lineHeight": "24px", "weight": 500 },
      "p1":      { "size": "20px", "lineHeight": "30px", "weight": 400 },
      "p2":      { "size": "16px", "lineHeight": "24px", "weight": 400 },
      "p3":      { "size": "14px", "lineHeight": "22px", "weight": 400 },
      "caption": { "size": "11px", "lineHeight": "16px", "weight": 500, "transform": "uppercase", "tracking": "wide" }
    }
  },
  "layout": {
    "containerSite":   "1280px",
    "containerNarrow": "1080px",
    "headerHeight":    "72px",
    "gutters": { "mobile": "20px", "sm": "32px", "md": "48px", "lg": "80px" },
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
  },
  "radius": {
    "lg":   "8px",
    "xl":   "12px",
    "2xl":  "16px",
    "full": "9999px"
  },
  "spacing": {
    "section": "96px",
    "cardGap": "24px",
    "cardPad": "24px"
  },
  "shadow": {
    "dropdown": "0 20px 50px -20px rgba(35, 42, 52, 0.4)",
    "card":     "0 24px 50px -24px rgba(35, 42, 52, 0.55)",
    "detail":   "0 40px 90px -40px rgba(55, 89, 113, 0.4)"
  }
}
